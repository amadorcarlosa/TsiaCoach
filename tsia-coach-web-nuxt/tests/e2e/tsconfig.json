{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "~/*": ["../../app/*"],
      "#shared/*": ["../../shared/*"],
      "#server/*": ["../../server/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts"]
}
